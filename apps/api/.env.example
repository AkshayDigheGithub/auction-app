# Copy this file to .env and fill in what you have. Everything except
# DATABASE_URL is optional in development — unset integrations fall back to
# mock/dev providers so the app runs end-to-end with zero external accounts.

# Required for any database-backed route. Get a free Postgres+PostGIS
# connection string from https://neon.tech (enable the postgis extension
# via `CREATE EXTENSION IF NOT EXISTS postgis;` — Prisma migrate also does
# this automatically on first migrate).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs/verifies JWTs issued after OTP verification. Any long random string.
JWT_SECRET="dev-only-change-me"

# Signs/verifies deal QR tokens (HMAC). Any long random string.
QR_SIGNING_SECRET="dev-only-change-me-too"

# Redis for bid caching / realtime fan-out (Upstash free tier works well:
# https://upstash.com — use the "ioredis"/TCP connection string, not REST).
# Leave unset to use an in-memory fallback (fine for single-instance dev).
REDIS_URL=""

# MSG91 OTP SMS (https://msg91.com). Leave unset to use the console OTP
# provider, which logs the code to the API's stdout instead of sending SMS.
MSG91_API_KEY=""
MSG91_SENDER_ID=""

# Razorpay commission collection (https://razorpay.com). Leave unset to use
# the mock payment provider, which marks commission "paid" instantly.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Google Maps Platform — Geocoding + Places (https://console.cloud.google.com).
# Leave unset to use a mock geocoder that returns a fixed Bengaluru coordinate.
# Set a billing cap/alert on the GCP project before using a real key (see spec).
GOOGLE_MAPS_API_KEY=""

PORT=3001
CORS_ORIGIN="http://localhost:3000"
