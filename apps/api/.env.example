# Copy this file to .env and fill in what you have. Everything except
# DATABASE_URL is optional in development — unset integrations fall back to
# mock/dev providers so the app runs end-to-end with zero external accounts.

# Required for any database-backed route. Get a free Postgres+PostGIS
# connection string from https://neon.tech (enable the postgis extension
# via `CREATE EXTENSION IF NOT EXISTS postgis;` — Prisma migrate also does
# this automatically on first migrate).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs/verifies JWTs issued after OTP verification. Any long random string.
JWT_SECRET="dev-only-change-me"

# Signs/verifies deal QR tokens (HMAC). Any long random string.
QR_SIGNING_SECRET="dev-only-change-me-too"

# Redis for bid caching / realtime fan-out (Upstash free tier works well:
# https://upstash.com — use the "ioredis"/TCP connection string, not REST).
# Leave unset to use an in-memory fallback (fine for single-instance dev).
REDIS_URL=""

# MSG91 OTP SMS (https://msg91.com). Leave unset to use the console OTP
# provider, which logs the code to the API's stdout instead of sending SMS.
MSG91_API_KEY=""
MSG91_SENDER_ID=""

# Billing mode. "shadow" (the default) computes the fee on every locked deal
# and records it, but charges nothing, gates nothing and consumes no free-trial
# allowance — this is what the free pilot runs on, and it produces the
# "would-be revenue" figure on the admin dashboard.
#
# "live" debits the shop's prepaid wallet at deal lock, gates matching on
# balance, and consumes the free trial. Do NOT switch this on before the GST
# position (AUC-74) and the wallet refund policy (AUC-75) are settled.
BILLING_MODE="shadow"

# Razorpay. Wallet top-ups are NOT implemented — POST /wallet/me/recharge
# deliberately returns 501. Collecting money from shops is blocked on the two
# decisions above. Admin can credit a wallet manually in the meantime.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Google Maps Platform — Geocoding + Places (https://console.cloud.google.com).
# Leave unset to use a mock geocoder that returns a fixed Bengaluru coordinate.
# Set a billing cap/alert on the GCP project before using a real key (see spec).
GOOGLE_MAPS_API_KEY=""

# Web Push (VAPID) for shop owner notifications on new nearby requests
# (AUC-21). Generate a keypair with `npx web-push generate-vapid-keys` from
# apps/api. VAPID_PUBLIC_KEY must match NEXT_PUBLIC_VAPID_PUBLIC_KEY in
# apps/web's env. Leave unset to log pushes instead of sending them.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"

PORT=3001
CORS_ORIGIN="http://localhost:3000"
