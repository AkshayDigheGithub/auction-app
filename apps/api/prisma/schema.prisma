// Prisma schema for the hyperlocal reverse-auction app.
// See mvp-spec-hyperlocal-bid-app_1.md section 7 for the source schema this mirrors.

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum Role {
  customer
  shop_owner
  admin
}

// Shop categories drive the commission rate (see CommissionRate). Spec §9 scopes
// the pilot to mobile/electronics only — the rest exist so per-category pricing
// and matching don't need a retrofit later (BACKLOG-monetization.md §4, AUC-57).
enum ShopCategory {
  mobile_electronics
  computers
  appliances
  hardware
  auto_parts
  furniture
  apparel
  jewellery
  grocery
}

enum RequestStatus {
  open
  locked
  completed
  cancelled
}

enum BidStatus {
  active
  withdrawn
  rejected
  won
}

enum QrStatus {
  pending
  scanned
  confirmed
}

// Every wallet movement is one of these. Debits carry a negative amountPaise.
enum WalletTxnType {
  recharge
  deal_fee
  reversal
  bonus
  admin_credit
  admin_debit
  trial_waiver
}

// What actually happened to the fee on a deal.
//   shadow       — computed but not charged (BILLING_MODE=shadow, the pilot default)
//   waived_trial — inside the shop's first N free deals
//   charged      — debited from the shop wallet
//   reversed     — charged, then credited back after a customer reversal
enum DealFeeStatus {
  shadow
  waived_trial
  charged
  reversed
}

enum ReversalStatus {
  pending
  approved
  rejected
}

// --- Conduct disputes (AUC-34) ---
// Distinct from DealReversal, which is a billing correction: a reversal asks
// "should this fee stand", a dispute asks "did this shop behave". They are
// separate because the fee question disappears in shadow mode while the
// conduct question is exactly what a pilot needs an answer to.

enum DisputeParty {
  customer
  shop_owner
}

// A closed list, not free text. "Three customers said this shop would not
// honour its bid" is something an admin can act on; three paragraphs are not.
enum DisputeReason {
  bid_not_honoured
  price_higher_in_shop
  item_not_available
  shop_unreachable
  customer_no_show
  conduct
  other
}

enum DisputeStatus {
  open
  upheld
  dismissed
}

// A user is identified by a phone number, an email, or both — never neither.
//
// Phone was the only identifier while OTP was the only way in (AUC-7). Google
// sign-in (AUC-85) arrives with a verified email and no phone, so both columns
// are nullable and a CHECK constraint in the migration enforces "at least one".
// Postgres allows many NULLs in a unique index, so both stay unique.
model User {
  id          String   @id @default(cuid())
  phoneNumber String?  @unique @map("phone_number")
  email       String?  @unique
  name        String?
  role        Role
  createdAt   DateTime @default(now()) @map("created_at")

  shop            Shop?
  requests        Request[]
  deals           Deal[]
  disputesRaised  Dispute[]

  @@map("users")
}

model Shop {
  id           String       @id @default(cuid())
  ownerUserId  String       @unique @map("owner_user_id")
  owner        User         @relation(fields: [ownerUserId], references: [id])
  shopName     String       @map("shop_name")
  address      String
  latitude     Float
  longitude    Float
  location     Unsupported("geography(Point, 4326)")?
  category     ShopCategory @default(mobile_electronics)
  // Additional categories this shop also serves (AUC-60). The fee always follows
  // the category the *request* falls under, never the shop's primary — otherwise
  // a shop could register as `jewellery` (0.30%) and take electronics deals cheap.
  secondaryCategories ShopCategory[] @default([]) @map("secondary_categories")
  upiId        String?      @map("upi_id")
  // How an admin reaches this shop: to verify it exists (spec §4 does that by
  // phone call) and to work a dispute — `shop_unreachable` and
  // `customer_no_show` both need someone contactable at the other end.
  //
  // Lives here rather than on User because User.phoneNumber is globally
  // unique, and family-run shops routinely share one number between owners,
  // or use a number that is already a customer account. Deliberately not
  // unique, and not OTP-verified for the pilot (AUC-89) — admin verification
  // is what catches a bad number while SMS stays at zero.
  contactPhone String?      @map("contact_phone")
  verified     Boolean      @default(false)
  photoUrl     String?      @map("photo_url")
  gstNumber    String?      @map("gst_number")
  createdAt    DateTime     @default(now()) @map("created_at")

  // --- Prepaid wallet (AUC-48) ---
  // Integer paise, never float. Guarded so it can never go negative.
  walletBalancePaise Int @default(0) @map("wallet_balance_paise")
  // Free trial is a counter, not a calendar (AUC-52) — it self-adjusts to how
  // fast demand actually ramps in this shop's area.
  freeDealsUsed      Int @default(0) @map("free_deals_used")
  suspended          Boolean @default(false)
  suspendedReason    String? @map("suspended_reason")

  bids Bid[]
  deals Deal[]
  disputes Dispute[]
  pushSubscriptions PushSubscription[]
  walletTransactions WalletTransaction[]

  @@index([latitude, longitude])
  @@index([category])
  @@map("shops")
}

/**
 * Append-only ledger. Every balance change writes exactly one row here inside the
 * same transaction as the balance update — a balance movement with no ledger row
 * is a bug, and `balanceAfterPaise` makes the ledger self-verifying (AUC-48).
 */
model WalletTransaction {
  id                String        @id @default(cuid())
  shopId            String        @map("shop_id")
  shop              Shop          @relation(fields: [shopId], references: [id])
  type              WalletTxnType
  /// Signed: credits positive, debits negative.
  amountPaise       Int           @map("amount_paise")
  balanceAfterPaise Int           @map("balance_after_paise")
  dealId            String?       @map("deal_id")
  reason            String
  /// Set only for manual admin adjustments (AUC-64).
  createdByUserId   String?       @map("created_by_user_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([shopId, createdAt])
  @@index([type, createdAt])
  @@map("wallet_transactions")
}

/**
 * Per-category commission configuration (AUC-51). Editable from admin without a
 * deploy (AUC-66). Replaces the old hardcoded `COMMISSION_RATE = 0.02`, which was
 * picked to mirror Razorpay's card rate rather than derived from shop margins.
 *
 * Rule of thumb behind the seeded values: take ~20% of the shop's typical gross
 * margin, never more.
 */
model CommissionRate {
  category        ShopCategory @id
  /// Basis points. 60 = 0.60%.
  rateBps         Int          @map("rate_bps")
  /// Upper bound per deal. Null means uncapped.
  capPaise        Int?         @map("cap_paise")
  /// Lower bound per deal, so a tiny sale isn't more admin than it's worth.
  floorPaise      Int          @default(2000) @map("floor_paise")
  /// When set, the fee is this flat amount and rate/cap/floor are ignored
  /// (grocery: a percentage of a ₹300 basket isn't worth billing).
  flatFeePaise    Int?         @map("flat_fee_paise")
  active          Boolean      @default(true)
  updatedAt       DateTime     @updatedAt @map("updated_at")
  updatedByUserId String?      @map("updated_by_user_id")

  @@map("commission_rates")
}

/**
 * What the customer is asking for, as opposed to what kind of shop sells it.
 * A table rather than an enum because this list changes often and admin edits it
 * without a deploy (AUC-58 / AUC-72).
 */
model ProductCategory {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  parentId       String?           @map("parent_id")
  parent         ProductCategory?  @relation("ProductCategoryChildren", fields: [parentId], references: [id])
  children       ProductCategory[] @relation("ProductCategoryChildren")
  /// Which kinds of shop can serve this product category (AUC-59 matching).
  shopCategories ShopCategory[]    @map("shop_categories")
  sortOrder      Int               @default(0) @map("sort_order")
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now()) @map("created_at")

  requests Request[]

  @@index([parentId, sortOrder])
  @@map("product_categories")
}

/**
 * Customer-reported "I didn't buy" within the reversal window (AUC-54). The fee
 * goes back to the shop's wallet as credit — never a bank refund, which would
 * cost more in reconciliation than the ₹300 it returns.
 */
model DealReversal {
  id               String         @id @default(cuid())
  dealId           String         @unique @map("deal_id")
  deal             Deal           @relation(fields: [dealId], references: [id])
  reportedByUserId String         @map("reported_by_user_id")
  reason           String
  status           ReversalStatus @default(pending)
  resolvedByUserId String?        @map("resolved_by_user_id")
  resolvedAt       DateTime?      @map("resolved_at")
  resolutionNote   String?        @map("resolution_note")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("deal_reversals")
}

/**
 * A complaint about how a deal was honoured (AUC-34).
 *
 * Raised by either side — a customer whose quoted price was not honoured, or a
 * shop whose customer never arrived. Resolving one does not move money; it
 * produces the record the Verified badge and any suspension decision rest on,
 * which spec §4 calls the whole point of tying a real identity to a shop.
 *
 * One per person per deal (see @@unique): a complaint is a statement of what
 * happened, not a thing to file repeatedly until someone acts.
 */
model Dispute {
  id     String @id @default(cuid())
  dealId String @map("deal_id")
  deal   Deal   @relation(fields: [dealId], references: [id])
  /// Denormalised from the deal. Every per-shop query filters on it, and the
  /// subject of a complaint must not be able to change under it later.
  shopId String @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [id])

  raisedByUserId String       @map("raised_by_user_id")
  raisedBy       User         @relation(fields: [raisedByUserId], references: [id])
  /// Derived from the raiser's proven role in the deal, never from the request
  /// body — it decides which reasons are even sayable.
  raisedByParty  DisputeParty @map("raised_by_party")

  reason  DisputeReason
  details String?

  status           DisputeStatus @default(open)
  resolvedByUserId String?       @map("resolved_by_user_id")
  resolvedAt       DateTime?     @map("resolved_at")
  resolutionNote   String?       @map("resolution_note")
  createdAt        DateTime      @default(now()) @map("created_at")

  @@unique([dealId, raisedByUserId])
  @@index([status, createdAt])
  @@index([shopId, status])
  @@map("disputes")
}

/**
 * Append-only record of every privileged admin action (AUC-65). Admins can move
 * money now, so "who credited this shop ₹2,000 and why" must have an answer that
 * doesn't depend on someone remembering. Never editable or deletable from the UI.
 */
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model PushSubscription {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([shopId])
  @@map("push_subscriptions")
}

model Request {
  id              String        @id @default(cuid())
  customerUserId  String        @map("customer_user_id")
  customer        User          @relation(fields: [customerUserId], references: [id])
  productName     String        @map("product_name")
  description     String?
  areaText        String        @map("area_text")
  latitude        Float
  longitude       Float
  location        Unsupported("geography(Point, 4326)")?
  status          RequestStatus @default(open)
  createdAt       DateTime      @default(now()) @map("created_at")

  // Nullable on purpose (AUC-61): a customer who just types "iPhone 15" must
  // still be able to post. Category sharpens matching; it never gates demand.
  productCategoryId String?          @map("product_category_id")
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id])

  // Match outcome at post time (AUC-59). Recorded rather than recomputed: a
  // shop onboarded next week does not change the fact that this request
  // reached nobody when it was posted. Null on rows created before this.
  //
  // Kept as two numbers because zero reach has two opposite causes, and they
  // look identical to the customer: matched=0 is a supply/category problem
  // (nobody nearby sells this), matched>0 with notified=0 is a billing one
  // (they are all suspended or out of balance).
  matchedShopCount  Int?             @map("matched_shop_count")
  notifiedShopCount Int?             @map("notified_shop_count")

  bids Bid[]
  deal Deal?

  @@index([latitude, longitude])
  @@index([productCategoryId])
  @@index([notifiedShopCount])
  @@map("requests")
}

model Bid {
  id        String    @id @default(cuid())
  requestId String    @map("request_id")
  request   Request   @relation(fields: [requestId], references: [id])
  shopId    String    @map("shop_id")
  shop      Shop      @relation(fields: [shopId], references: [id])
  price     Decimal   @db.Decimal(10, 2)
  note      String?
  status    BidStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at")

  deal Deal?

  @@index([requestId])
  @@index([shopId])
  @@map("bids")
}

model Deal {
  id                String            @id @default(cuid())
  requestId         String            @unique @map("request_id")
  request           Request           @relation(fields: [requestId], references: [id])
  bidId             String            @unique @map("bid_id")
  bid               Bid               @relation(fields: [bidId], references: [id])
  customerUserId    String            @map("customer_user_id")
  customer          User              @relation(fields: [customerUserId], references: [id])
  shopId            String            @map("shop_id")
  shop              Shop              @relation(fields: [shopId], references: [id])
  finalPrice        Decimal           @db.Decimal(10, 2) @map("final_price")
  qrToken           String            @unique @map("qr_token")
  qrStatus          QrStatus          @default(pending) @map("qr_status")
  createdAt         DateTime          @default(now()) @map("created_at")
  completedAt       DateTime?         @map("completed_at")

  // --- Fee, charged at lock (AUC-50) ---
  // Replaces the old commissionAmount/commissionStatus pair. Those tracked a
  // charge that was triggered by the shop's own QR scan and never actually
  // collected, so there was nothing worth migrating.
  //
  // Rate, cap and category are SNAPSHOTS taken when the fee was computed. Later
  // rate changes must never rewrite what a shop was historically charged.
  feeAmountPaise Int?          @map("fee_amount_paise")
  feeRateBps     Int?          @map("fee_rate_bps")
  feeCapPaise    Int?          @map("fee_cap_paise")
  feeCategory    ShopCategory? @map("fee_category")
  feeStatus      DealFeeStatus @default(shadow) @map("fee_status")

  reversal DealReversal?
  disputes Dispute[]

  @@index([shopId, createdAt])
  @@index([feeStatus])
  @@map("deals")
}
