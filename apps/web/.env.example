NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Google Maps Platform key for the browser (Places Autocomplete + map pin on
# shop onboarding, AUC-15). Must allow the Maps JavaScript API and Places API,
# restricted to this site's origin. Leave unset to fall back to a plain
# address text field with no map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Web Push VAPID public key — must match VAPID_PUBLIC_KEY in apps/api's env
# (AUC-21). Leave unset to hide the "enable notifications" prompt on the
# shop owner's nearby-requests page.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Clerk (AUC-85). The PUBLISHABLE key from https://dashboard.clerk.com ->
# API keys, for the same instance as CLERK_SECRET_KEY in apps/api.
#
# Public by design — the browser has to send it. The secret key stays
# server-side and must never appear in a NEXT_PUBLIC_ variable.
#
# Enable Google as a social provider on that instance; it is the only sign-in
# method this screen offers. Leave unset to fall back to the phone OTP login,
# which is what local development does — no Clerk account required.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Keep the phone OTP login reachable alongside Clerk sign-in, as a "use your
# phone number instead" link (AUC-85 parks this flow rather than deleting it).
# Off unless exactly "true". Ignored — and treated as on — whenever
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is unset, since otherwise there would be
# no way to sign in at all.
NEXT_PUBLIC_ENABLE_OTP_LOGIN=""

# MSG91 "Login with OTP" widget. Set both to move OTP to the widget: MSG91
# generates, sends and checks the code, and the API only redeems the resulting
# access token. Leave unset to keep the server-side OTP flow (and the console
# provider locally, which needs no MSG91 account).
#
# Both are public by design — tokenAuth is scoped to the widget. The account
# authkey stays server-side as MSG91_API_KEY in apps/api.
NEXT_PUBLIC_MSG91_WIDGET_ID=""
NEXT_PUBLIC_MSG91_TOKEN_AUTH=""
