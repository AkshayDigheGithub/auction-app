NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Google Maps Platform key for the browser (Places Autocomplete + map pin on
# shop onboarding, AUC-15). Must allow the Maps JavaScript API and Places API,
# restricted to this site's origin. Leave unset to fall back to a plain
# address text field with no map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Web Push VAPID public key — must match VAPID_PUBLIC_KEY in apps/api's env
# (AUC-21). Leave unset to hide the "enable notifications" prompt on the
# shop owner's nearby-requests page.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
