{
  "name": "auction-app",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run start:dev -w api\" \"npm run dev -w web\"",
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w api && npm run build -w web",
    "build:api": "npm run build -w api",
    "migrate:deploy": "npm run migrate:deploy -w api",
    "start:api": "npm run start:prod -w api",
    "start": "npm run start:api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
