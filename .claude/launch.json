{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "auction-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev",
        "-w",
        "api"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "auction-api-attach",
      "url": "http://localhost:3001",
      "port": 3001
    },
    {
      "name": "auction-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "web"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "auction-app-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "auction-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "site"
      ],
      "port": 3002
    }
  ]
}
